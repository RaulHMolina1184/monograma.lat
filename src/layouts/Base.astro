---
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';

interface Props { title?: string; }
const { title } = Astro.props;

const pageTitle = title
  ? `${title} · Monograma`
  : 'Monograma — Estudio Creativo';
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />

    <title>{pageTitle}</title>
    <meta name="description" content="Monograma — Estudio Creativo. Software, diseño, marketing y fotografía." />

    <!-- Favicons -->
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#1F1F1F" />

    <!-- Tipografía -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Barlow:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <!-- Preload de imagen hero (le dice al navegador que la cargue primero) -->
    <link rel="preload" as="image" href="/images/fondoHero.webp" fetchpriority="high" />
  </head>
  <body>
    <SiteHeader />
    <main><slot /></main>
    <SiteFooter />
  </body>
</html>