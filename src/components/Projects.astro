---
const projects = [
  {
    title: 'Proyecto Uno',
    category: 'Diseño Web',
    image: '/images/pic01.jpg', // Usa tus imágenes reales aquí
    link: '/work',
  },
  {
    title: 'Proyecto Dos',
    category: 'Fotografía',
    image: '/images/pic02.jpg', // Usa tus imágenes reales aquí
    link: '/work',
  }
];
---
<section class="section section--projects" id="projects">
  <div class="container">
    <header class="projects-head">
      <h2>Trabajos recientes</h2>
    </header>

    <div class="projects-grid">
      {projects.map((p) => (
        <a href={p.link} class="project-card">
          <div class="project-image-wrap">
            <img src={p.image} alt={p.title} loading="lazy" />
          </div>
          <div class="project-info">
            <span class="project-category">{p.category}</span>
            <h3 class="project-title">{p.title}</h3>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .section--projects {
    background: var(--bg-alt); /* Usa el Soft Cream para contrastar */
    padding: var(--section-y) 0;
  }
  .projects-head {
    text-align: center;
    margin: 0 auto 3.5rem;
  }
  .projects-head h2 {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 3.5vw, 2.5rem);
    font-weight: 700;
    text-transform: uppercase;
    color: var(--ink);
  }
  
  .projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 2rem;
    max-width: 900px;
    margin: 0 auto;
  }

  /* Card Style */
  .project-card {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    text-decoration: none;
    group: project;
  }
  
  .project-image-wrap {
    overflow: hidden;
    border-radius: 12px;
    aspect-ratio: 4/3;
    background: var(--line);
  }
  .project-image-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }
  .project-card:hover .project-image-wrap img {
    transform: scale(1.05);
  }

  .project-info {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  .project-category {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--nintendo-red);
    font-weight: 700;
  }
  .project-title {
    font-family: var(--font-display);
    font-size: 1.35rem;
    color: var(--ink);
    margin: 0;
  }
</style>