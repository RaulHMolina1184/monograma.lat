---
interface Props {
  image?: string;
}
const { image = '/images/fondoHero.webp' } = Astro.props;
---
<section
  class="hero"
  style={`--hero-image: url('${image}')`}
>
  <div class="container hero-inner">
    <p class="hero-eyebrow">Estudio Creativo</p>

    <h1 class="hero-title">
      Software · Diseño<br />
      Marketing · Fotografía
    </h1>

    <p class="hero-lead">
      <strong class="brand-mention">Somos Creativos, Objetivos y Disruptivos, somos MONOGRAMA.</strong> 
    </p>

    <div class="hero-actions">
      <a href="#contact" class="btn btn-primary">Conversemos</a>
      <a href="#work" class="btn btn-ghost">Proyectos</a>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    display: grid;
    place-items: center;
    min-height: clamp(560px, 82vh, 820px);
    padding: 6rem 1.5rem;
    background-image: var(--hero-image);
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
  }

  .hero-inner {
    position: relative;
    z-index: 1;
    max-width: 900px;
    text-align: center;
    color: var(--paper-white);
  }

  /* ===== Eyebrow: solo "Estudio Creativo", caja más grande ===== */
  .hero-eyebrow {
    display: inline-block;
    font-family: var(--font-sans);
    font-size: .95rem;               /* antes .8rem */
    font-weight: 600;
    letter-spacing: .28em;
    text-transform: uppercase;
    color: var(--paper-white);
    margin-bottom: 2rem;
    padding: .8rem 1.75rem;          /* antes .5rem 1rem */
    border: 1px solid rgba(250, 248, 243, 0.4);
    border-radius: 999px;
    backdrop-filter: blur(6px);
    background: rgba(31, 31, 31, 0.28);
  }

  /* ===== Título: peso 500 ===== */
  .hero-title {
    font-family: var(--font-display);
    font-weight: 500;                 /* antes 800 */
    font-size: clamp(2.5rem, 6.5vw, 5rem);
    line-height: 1.05;
    letter-spacing: -0.02em;
    color: var(--paper-white);
    margin: 0 0 1.5rem;
  }

  /* ===== Lead ===== */
  .hero-lead {
    font-size: clamp(1rem, 1.6vw, 1.2rem);
    line-height: 1.55;
    max-width: 620px;
    margin: 0 auto;
    color: rgba(250, 248, 243, 0.9);
    font-weight: 400;
  }

  /* ===== Botones ===== */
  .hero-actions {
    display: flex;
    gap: .85rem;
    margin-top: 2.5rem;
    flex-wrap: wrap;
    justify-content: center;
  }

  .hero .btn {
    padding: 1rem 1.9rem;
    font-weight: 600;
    background: rgba(31, 31, 31, 0.35);
    color: var(--paper-white);
    border: 1px solid rgba(250, 248, 243, 0.5);
    backdrop-filter: blur(8px);
    transition:
      background .2s ease,
      color .2s ease,
      border-color .2s ease,
      transform .15s ease;
  }

  .hero .btn:hover {
    background: var(--paper-white);
    color: var(--pixel-black);
    border-color: var(--paper-white);
    transform: translateY(-1px);
  }

  @media (max-width: 640px) {
    .hero { padding: 4rem 1rem; min-height: 72vh; }
    .hero-eyebrow { font-size: .8rem; padding: .65rem 1.35rem; }
  }
</style>