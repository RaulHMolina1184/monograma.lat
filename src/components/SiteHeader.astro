---
const links = [
  { href: '/', label: 'Inicio' },
  { href: '/about', label: 'Nosotros' },
  { href: '/work', label: 'Proyectos' },
  { href: '/blog', label: 'Blog' },
];
const path = Astro.url.pathname;
---
<header class="site-header">
  <div class="container header-inner">
    <a href="/" class="brand">
      <img src="/images/imagoFondoClaro.png" alt="Monograma" class="brand-logo" />
    </a>

    <!-- Navegación Desktop -->
    <nav class="nav-desktop">
      {links.map(l => (
        <a href={l.href} class={path === l.href ? 'is-active' : ''}>{l.label}</a>
      ))}
      <a href="/contact" class="btn btn-primary">Conversemos</a>
    </nav>

    <!-- Navegación Móvil -->
    <details class="nav-mobile">
      <summary aria-label="Abrir menú">
        <span></span><span></span><span></span>
      </summary>
      <div class="mobile-menu-panel">
        {links.map(l => (
          <a href={l.href} class={path === l.href ? 'is-active' : ''}>{l.label}</a>
        ))}
        <a href="/contact" class="btn btn-primary">Conversemos</a>
      </div>
    </details>
  </div>
</header>

<style>
  /* Estilos base del header que ya tenías */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--bg) 85%, transparent);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--line);
  }
  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1rem 0;
  }
  .brand-logo { height: 40px; width: auto; display: block; }

  /* Navegación Desktop */
  .nav-desktop {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }
  .nav-desktop a {
    color: var(--ink-soft);
    font-weight: 500;
    font-size: .95rem;
    transition: color .2s ease;
  }
  .nav-desktop a:hover, .nav-desktop a.is-active { color: var(--ink); }
  
  /* Tu botón rojo existente */
  .nav-desktop .btn, .mobile-menu-panel .btn {
    background: var(--nintendo-red);
    color: var(--paper-white);
    padding: .65rem 1.4rem;
    font-size: .9rem;
    font-weight: 700;
    border: 2px solid transparent;
    border-radius: 8px;
    transition: all .2s ease;
  }
  .nav-desktop .btn:hover, .mobile-menu-panel .btn:hover {
    background: var(--paper-white);
    color: var(--nintendo-red);
    border-color: var(--nintendo-red);
    transform: translateY(-1px);
  }

  /* Menú Móvil Oculto por defecto */
  .nav-mobile { display: none; position: relative; }
  
  /* Hamburguesa */
  .nav-mobile summary {
    list-style: none;
    cursor: pointer;
    display: flex;
    flex-direction: column;
    gap: 5px;
    padding: .5rem;
  }
  .nav-mobile summary::-webkit-details-marker { display: none; }
  .nav-mobile summary span {
    display: block;
    width: 24px;
    height: 2px;
    background: var(--ink);
    transition: .2s ease;
  }
  
  /* Panel desplegable */
  .mobile-menu-panel {
    position: absolute;
    top: calc(100% + 1rem);
    right: 0;
    width: 200px;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 8px;
    padding: 1rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    box-shadow: var(--shadow-md);
  }
  .mobile-menu-panel a { color: var(--ink); font-weight: 500; }
  .mobile-menu-panel .btn { text-align: center; margin-top: .5rem; }

  /* Responsive Breakpoint */
  @media (max-width: 768px) {
    .nav-desktop { display: none; }
    .nav-mobile { display: block; }
  }
</style>