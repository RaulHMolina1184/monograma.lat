---
const links = [
  { href: '/', label: 'Inicio' },
  { href: '/about', label: 'Nosotros' },
  { href: '/work', label: 'Proyectos' },
  { href: '/blog', label: 'Blog' },
];
const path = Astro.url.pathname;
---
<header class="site-header">
  <div class="container header-inner">
    <a href="/" class="brand">
      <img
        src="/images/imagoHeader.png"
        alt="Monograma — Estudio Creativo"
        class="brand-logo"
      />
    </a>
    <nav class="nav">
      {links.map(l => (
        <a href={l.href} class={path === l.href ? 'is-active' : ''}>{l.label}</a>
      ))}
      <a href="/contact" class="btn btn-primary">Conversemos</a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--bg) 85%, transparent);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--line);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1rem 0;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: .55rem;
  }

  .brand-logo {
    height: 40px;
    width: auto;
    display: block;
  }

  .nav {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .nav a {
    color: var(--ink-soft);
    font-weight: 500;
    font-size: .95rem;
    position: relative;
    transition: color .2s ease;
  }

  .nav a:hover,
  .nav a.is-active {
    color: var(--ink);
  }

  .nav a.is-active::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: -6px;
    height: 2px;
    background: var(--nintendo-red);
    border-radius: 2px;
  }

  .nav .btn {
    background: var(--nintendo-red);
    color: var(--paper-white);
    padding: .65rem 1.4rem;
    font-size: .9rem;
    font-weight: 700;
    letter-spacing: .01em;
    border: 2px solid transparent;
    
    transition:
      background .2s ease,
      color .2s ease,
      border-color .2s ease,
      transform .15s ease;
  }

  .nav .btn:hover {
    background: var(--paper-white);
    color: var(--nintendo-red);
    border-color: var(--nintendo-red);
    transform: translateY(-1px);
  }

  /* ===== Tablets ===== */
  @media (max-width: 860px) {
    .header-inner { padding: .85rem 0; }
    .brand-logo { height: 34px; }
    .nav { gap: 1rem; }
    .nav a { font-size: .9rem; }
    .nav .btn {
      padding: .55rem 1.1rem;
      font-size: .85rem;
    }
  }

  /* ===== Móviles ===== */
  @media (max-width: 640px) {
    .header-inner {
      padding: .75rem 0;
      gap: .75rem;
    }
    .brand-logo { height: 30px; }
    .nav a:not(.btn) { display: none; }
    .nav .btn {
      padding: .5rem 1rem;
      font-size: .8rem;
      border-radius: 999px;
    }
  }
</style>