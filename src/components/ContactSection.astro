---
---
<section class="section section--contact" id="contact">
  <!-- <span class="section-title">Contacto</span> -->
  <div class="container">
    <header class="contact-head">
      <h2>¿Qué tenés en mente?</h2>
    </header>

    <form id="contact-form" class="contact-form" novalidate>
      <!-- Access Key de Web3Forms -->
      <input type="hidden" name="access_key" value="389afc51-b387-471f-b76e-ec1e41439fd2" />

      <!-- Asunto y origen (opcional pero útil) -->
      <input type="hidden" name="subject" value="Nuevo mensaje desde monograma.lat" />
      <input type="hidden" name="from_name" value="Monograma — Formulario web" />

      <!-- Honeypot anti-spam (oculto) -->
      <input type="checkbox" name="botcheck" class="hidden-honeypot" tabindex="-1" autocomplete="off" />

      <div class="form-row">
        <div class="form-field">
          <label for="name">Nombre</label>
          <input type="text" id="name" name="name" placeholder="Tu nombre" required />
        </div>
        <div class="form-field">
          <label for="email">Email</label>
          <input type="email" id="email" name="email" placeholder="tu@email.com" required />
        </div>
      </div>

      <div class="form-field">
        <label for="message">Mensaje</label>
        <textarea id="message" name="message" rows="5" placeholder="Cuéntanos sobre tu proyecto..." required></textarea>
      </div>

      <div class="form-actions">
        <button type="submit" class="btn btn-primary" id="submit-btn">
          Enviar mensaje
        </button>
        <p class="form-note">
          O escríbenos directo a <a href="mailto:info@monograma.lat">info@monograma.lat</a>
        </p>
      </div>

      <div id="form-result" class="form-result" role="status" aria-live="polite"></div>
    </form>
  </div>
</section>

<style>
  .section--contact {
    background: var(--bg);
    padding: var(--section-y) 0;
    position: relative;
  }

  .contact-head {
    text-align: center;
    max-width: 640px;
    margin: 0 auto 3rem;
  }

  .contact-head h2 {
    font-size: clamp(1.75rem, 3.5vw, 2.5rem);
    margin: 0 0 .75rem;
  }

  .contact-head p {
    color: var(--ink-soft);
    margin: 0;
  }

  .contact-form {
    max-width: 640px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.25rem;
  }

  @media (max-width: 640px) {
    .form-row { grid-template-columns: 1fr; }
  }

  .form-field {
    display: flex;
    flex-direction: column;
    gap: .5rem;
  }

  .form-field label {
    font-size: .85rem;
    font-weight: 600;
    color: var(--ink);
    letter-spacing: .02em;
  }

  .form-field input,
  .form-field textarea {
    width: 100%;
    padding: .85rem 1rem;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: var(--surface);
    font: inherit;
    font-size: .95rem;
    color: var(--ink);
    transition: border-color .2s ease, box-shadow .2s ease;
  }

  .form-field input:focus,
  .form-field textarea:focus {
    outline: none;
    border-color: var(--nintendo-red);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--nintendo-red) 15%, transparent);
  }

  .form-field textarea {
    resize: vertical;
    min-height: 120px;
  }

  .form-actions {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    flex-wrap: wrap;
    margin-top: .5rem;
  }

  .form-note {
    font-size: .85rem;
    color: var(--ink-soft);
    margin: 0;
  }

  .form-note a {
    color: var(--nintendo-red);
    font-weight: 600;
  }

  /* Resultado del envío */
  .form-result {
    margin-top: 1rem;
    padding: 1rem 1.25rem;
    border-radius: 8px;
    font-size: .9rem;
    display: none;
  }
  .form-result.is-visible { display: block; }
  .form-result.is-success {
    background: color-mix(in srgb, var(--mint-green) 20%, transparent);
    color: #2e8b46;
    border: 1px solid color-mix(in srgb, var(--mint-green) 40%, transparent);
  }
  .form-result.is-error {
    background: color-mix(in srgb, var(--nintendo-red) 12%, transparent);
    color: var(--accent-hover);
    border: 1px solid color-mix(in srgb, var(--nintendo-red) 30%, transparent);
  }

  /* Honeypot oculto */
  .hidden-honeypot {
    position: absolute;
    left: -9999px;
    opacity: 0;
    pointer-events: none;
  }

  /* Botón deshabilitado */
  .btn[disabled] {
    opacity: .6;
    cursor: not-allowed;
    transform: none;
  }
</style>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const result = document.getElementById('form-result') as HTMLDivElement;
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();

    const originalText = submitBtn.textContent;
    submitBtn.disabled = true;
    submitBtn.textContent = 'Enviando...';
    result.className = 'form-result';

    const formData = new FormData(form);

    try {
      const response = await fetch('https://api.web3forms.com/submit', {
        method: 'POST',
        body: formData,
      });
      const data = await response.json();

      if (data.success) {
        result.textContent = '¡Mensaje enviado! Te contactaremos pronto.';
        result.classList.add('is-visible', 'is-success');
        form.reset();
      } else {
        result.textContent = data.message || 'Hubo un error. Inténtalo de nuevo.';
        result.classList.add('is-visible', 'is-error');
      }
    } catch (error) {
      result.textContent = 'Error de conexión. Revisa tu internet e inténtalo otra vez.';
      result.classList.add('is-visible', 'is-error');
    } finally {
      submitBtn.disabled = false;
      submitBtn.textContent = originalText;
    }
  });
</script>