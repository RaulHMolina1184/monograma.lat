---
---
<section class="section section--contact" id="contact">
  <div class="container">
    <header class="contact-head">
      <h2>¿Qué tenés en mente?</h2>
    </header>

    <form id="contact-form" class="contact-form" novalidate>
      <!-- Access Key de Web3Forms -->
      <input type="hidden" name="access_key" value="389afc51-b387-471f-b76e-ec1e41439fd2" />
      <input type="hidden" name="subject" value="Nuevo mensaje desde monograma.lat" />
      <input type="hidden" name="from_name" value="Monograma — Formulario web" />

      <!-- Honeypot anti-spam -->
      <input type="checkbox" name="botcheck" class="hidden-honeypot" tabindex="-1" autocomplete="off" />

      <div class="form-row">
        <div class="form-field">
          <label for="name">Nombre</label>
          <input type="text" id="name" name="name" placeholder="Tu nombre" required />
        </div>
        <div class="form-field">
          <label for="email">Email</label>
          <input type="email" id="email" name="email" placeholder="tu@email.com" required />
        </div>
      </div>

      <div class="form-field">
        <label for="message">Mensaje</label>
        <textarea id="message" name="message" rows="5" placeholder="Cuéntanos sobre tu proyecto..." required></textarea>
      </div>

      <div class="form-actions">
        <button type="submit" class="btn btn-primary" id="submit-btn">
          Enviar mensaje
        </button>
        <p class="form-note">
          O escríbenos directo a <a href="mailto:info@monograma.lat">info@monograma.lat</a>
        </p>
      </div>
    </form>
  </div>
</section>

<!-- MODAL DE RESULTADO (Oculto por defecto) -->
<div id="result-modal" class="modal-overlay">
  <div class="modal-box">
    <div id="modal-icon" class="modal-icon"></div>
    <h3 id="modal-title" class="modal-title"></h3>
    <p id="modal-message" class="modal-message"></p>
    <button id="modal-close" class="btn btn-primary">Entendido</button>
  </div>
</div>

<style>
  .section--contact {
    background: var(--bg);
    padding: var(--section-y) 0;
    position: relative;
  }

  .contact-head {
    text-align: center;
    max-width: 640px;
    margin: 0 auto 3rem;
  }

  .contact-head h2 {
    font-size: clamp(1.75rem, 3.5vw, 2.5rem);
    margin: 0 0 .75rem;
  }

  .contact-form {
    max-width: 640px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .contact-form .btn {
    align-self: flex-start;
    padding: .9rem 1.75rem;
    font-size: .95rem;
    margin-top: .25rem;
    background: var(--nintendo-red);
    color: var(--paper-white);
    border: 2px solid transparent;
    border-radius: 8px;
    font-weight: 700;
    cursor: pointer;
    transition: all .2s ease;
  }

  .contact-form .btn:hover {
    background: var(--paper-white);
    color: var(--nintendo-red);
    border-color: var(--nintendo-red);
    transform: translateY(-1px);
  }

  .contact-form .btn:disabled {
    opacity: .6;
    cursor: not-allowed;
    transform: none;
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.25rem;
  }

  @media (max-width: 640px) {
    .form-row { grid-template-columns: 1fr; }
  }

  .form-field {
    display: flex;
    flex-direction: column;
    gap: .5rem;
  }

  .form-field label {
    font-size: .85rem;
    font-weight: 600;
    color: var(--ink);
  }

  .form-field input,
  .form-field textarea {
    width: 100%;
    padding: .85rem 1rem;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: var(--surface);
    font: inherit;
    font-size: .95rem;
    color: var(--ink);
    transition: border-color .2s ease, box-shadow .2s ease;
  }

  .form-field input:focus,
  .form-field textarea:focus {
    outline: none;
    border-color: var(--nintendo-red);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--nintendo-red) 15%, transparent);
  }

  .form-field textarea {
    resize: vertical;
    min-height: 120px;
  }

  .form-actions {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    flex-wrap: wrap;
    margin-top: .5rem;
  }

  .form-note {
    font-size: .85rem;
    color: var(--ink-soft);
    margin: 0;
  }

  .form-note a {
    color: var(--nintendo-red);
    font-weight: 600;
  }

  .hidden-honeypot {
    position: absolute;
    left: -9999px;
    opacity: 0;
  }

  /* =========================================
     ESTILOS DEL MODAL
     ========================================= */
  .modal-overlay {
    position: fixed;
    top: 0; left: 0; right: 0; bottom: 0;
    background: rgba(31, 31, 31, 0.7); /* Pixel black con opacidad */
    backdrop-filter: blur(4px);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 9999;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.3s ease, visibility 0.3s ease;
  }

  .modal-overlay.is-active {
    opacity: 1;
    visibility: visible;
  }

  .modal-box {
    background: var(--surface);
    padding: 3rem 2.5rem;
    border-radius: 12px;
    text-align: center;
    max-width: 420px;
    width: 90%;
    transform: translateY(20px);
    transition: transform 0.3s ease;
    box-shadow: 0 20px 40px rgba(0,0,0,0.2);
  }

  .modal-overlay.is-active .modal-box {
    transform: translateY(0);
  }

  .modal-icon {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    margin: 0 auto 1.5rem;
    display: grid;
    place-items: center;
    font-size: 2rem;
  }

  .modal-icon.success {
    background: color-mix(in srgb, var(--mint-green) 20%, transparent);
    color: var(--mint-green);
  }

  .modal-icon.error {
    background: color-mix(in srgb, var(--nintendo-red) 15%, transparent);
    color: var(--nintendo-red);
  }

  .modal-title {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 700;
    margin: 0 0 0.5rem;
    color: var(--ink);
    text-transform: uppercase;
  }

  .modal-message {
    font-size: 1rem;
    color: var(--ink-soft);
    margin-bottom: 2rem;
    line-height: 1.5;
  }
    /* Botón del modal con el mismo hover del formulario */
  .modal-box .btn {
    display: inline-block;
    background: var(--nintendo-red);
    color: var(--paper-white);
    border: 2px solid transparent;
    border-radius: 8px;
    padding: .85rem 1.75rem;
    font-size: .95rem;
    font-weight: 700;
    cursor: pointer;
    transition: background .2s ease, color .2s ease, border-color .2s ease, transform .15s ease;
  }

  .modal-box .btn:hover {
    background: var(--paper-white);
    color: var(--nintendo-red);
    border-color: var(--nintendo-red);
    transform: translateY(-1px);
  }


</style>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;

  // Elementos del Modal
  const modal = document.getElementById('result-modal') as HTMLDivElement;
  const modalIcon = document.getElementById('modal-icon') as HTMLDivElement;
  const modalTitle = document.getElementById('modal-title') as HTMLHeadingElement;
  const modalMessage = document.getElementById('modal-message') as HTMLParagraphElement;
  const modalClose = document.getElementById('modal-close') as HTMLButtonElement;

  // Función para abrir el modal
  function showModal(type: 'success' | 'error', title: string, message: string) {
    modalIcon.className = `modal-icon ${type}`;
    modalIcon.innerHTML = type === 'success' ? '✓' : '✕';
    modalTitle.textContent = title;
    modalMessage.textContent = message;
    modal.classList.add('is-active');
  }

  // Cerrar modal
  function closeModal() {
    modal.classList.remove('is-active');
  }

  modalClose.addEventListener('click', closeModal);
  modal.addEventListener('click', (e) => {
    if (e.target === modal) closeModal(); // Cierra si hace clic fuera de la caja
  });

  // Lógica del formulario
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();

    const originalText = submitBtn.textContent;
    submitBtn.disabled = true;
    submitBtn.textContent = 'Enviando...';

    const formData = new FormData(form);

    try {
      const response = await fetch('https://api.web3forms.com/submit', {
        method: 'POST',
        body: formData,
      });
      const data = await response.json();

      if (data.success) {
        form.reset();
        showModal('success', '¡Mensaje enviado!', 'Gracias por escribirnos. Te contactaremos pronto.');
      } else {
        showModal('error', 'Hubo un error', data.message || 'No pudimos enviar el mensaje. Inténtalo de nuevo.');
      }
    } catch (error) {
      showModal('error', 'Error de conexión', 'Revisa tu internet e inténtalo otra vez.');
    } finally {
      submitBtn.disabled = false;
      submitBtn.textContent = originalText;
    }
  });
</script>