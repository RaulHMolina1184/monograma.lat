---
import Base from '../layouts/Base.astro';

// Datos del equipo
const equipo = [
  {
    nombre: 'Raúl Hernández Molina',
    rol: 'Fundador · Desarrollo tecnológico · Diseño creativo',
    foto: '/images/equipo/teamPortraitRHM.jpg',
    bio: [
      'Estudiante de Ingeniería en Sistemas, egresado del Colegio Universitario de Cartago con especialidad en Tecnologías de la Información, con formación complementaria en diseño gráfico y experiencia en fotografía, comunicación visual, desarrollo digital y gestión de proyectos. Su trayectoria combina experiencias que van desde la ebanistería y el trabajo manual hasta el diseño y la tecnología, integrando pensamiento lógico, sensibilidad visual y estrategia desde una perspectiva multidisciplinaria.',

      'Desde temprana edad mostró un profundo interés por el diseño, las marcas, los logotipos y la construcción de objetos, una inquietud que siempre ha estado acompañada de una curiosidad insaciable por comprender cómo funcionan las cosas y descubrir qué hay detrás de ellas. Esta inquietud lo dirigió hacia el diseño gráfico y posteriormente hacia las tecnologías de la información, encontrando en el desarrollo web un espacio donde se unen la creatividad y funcionalidad. Su proceso de aprendizaje se caracteriza por la investigación, la experimentación, la atención al detalle y una disposición autodidacta que también se refleja en sus intereses personales, como el ciclismo de montaña.',

      'Como fundador de Monograma, busca integrar el desarrollo de software, diseño gráfico y de marca, fotografía comercial y estrategia en una propuesta creativa que vaya más allá de los límites tradicionales entre disciplinas. Su visión parte de cuestionar lo establecido, explorar nuevas posibilidades y conectar distintas formas de pensamiento para transformar ideas en soluciones funcionales, visualmente coherentes y con identidad propia.'
    ]
  }
];
---
<Base title="Equipo — Monograma">
  <section class="section team-section">
    <div class="container">

      <div class="team-list">
        {equipo.map((persona) => (
          <article class="team-profile">

            <!-- Columna Izquierda: Foto -->
            <div class="team-sticky-container">
              <div class="team-image-wrapper">
                <img src={persona.foto} alt={`Foto de ${persona.nombre}`} class="team-image" />
              </div>
            </div>

            <!-- Columna Derecha: Info -->
            <div class="team-info">
              <h2 class="team-name">{persona.nombre}</h2>
              <span class="team-role">{persona.rol}</span>

              <div class="team-bio">
                {persona.bio.map(parrafo => (
                  <p>{parrafo}</p>
                ))}
              </div>
            </div>

          </article>
        ))}
      </div>

    </div>
  </section>
</Base>

<style>
  /* --- Sección --- */
  .team-section {
    padding: 6rem 0;
    background: var(--bg);
  }

  /* --- Layout del Perfil --- */
  .team-profile {
    display: grid;
    grid-template-columns: 1fr 1.5fr;
    gap: 4rem;
    align-items: stretch; /* la columna de la foto se estira para que el sticky tenga recorrido */
    max-width: 1000px;
    margin: 0 auto;
  }

  /* --- Columna de la foto: ocupa toda la altura de la fila --- */
  .team-sticky-container {
    height: 100%;
  }

  /* --- Foto (Sticky) --- */
  .team-image-wrapper {
    position: sticky;
    top: 6rem; /* ajusta según la altura de tu header */
    margin: 0;
    padding: 0;
    /* Sin overflow: hidden para no romper el sticky */
  }

  .team-image {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    filter: grayscale(100%);
    transition: filter 0.4s ease;
  }

  /* Efecto al pasar el puntero (Desktop) */
  .team-image-wrapper:hover .team-image {
    filter: grayscale(0%);
  }

  /* --- Textos --- */
  .team-info {
    padding-top: 0;
  }

  .team-name {
    font-family: var(--font-display);
    font-size: clamp(2rem, 3vw, 2.8rem);
    font-weight: 700;
    color: var(--ink);
    margin: 0 0 0.5rem;
    padding: 0;
    line-height: 1; /* sin espacio extra arriba de las mayúsculas */
    text-transform: uppercase;
  }

  .team-role {
    display: block;
    font-size: 0.9rem;
    color: var(--nintendo-red);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 2rem;
  }

  .team-bio p {
    font-size: 1.05rem;
    line-height: 1.75;
    color: var(--ink-soft);
    margin: 0 0 1.5rem;
  }

  /* --- Responsive (Móviles y Tablets) --- */
  @media (max-width: 860px) {
    .team-profile {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }

    .team-sticky-container {
      height: auto;
    }

    .team-image-wrapper {
      position: relative; /* Desactivamos sticky en móviles */
      top: 0;
      max-width: 320px;
      margin: 0 auto;
    }

    .team-info {
      text-align: left;
    }

    .team-name {
      font-size: 2rem;
      text-align: center;
    }

    .team-role {
      text-align: center;
      margin-bottom: 1.5rem;
    }
  }
</style>