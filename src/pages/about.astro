---
import Base from '../layouts/Base.astro';
---
<Base title="Nosotros">
  <section class="section" style="padding: 6rem 0; min-height: 60vh;">
    <div class="container">
      <h1 style="font-size: 3rem; margin-bottom: 1rem;">Nosotros</h1>
      <p style="max-width: 600px; font-size: 1.1rem; color: var(--ink-soft);">
        Somos Monograma. Un estudio creativo enfocado en conectar marcas con personas a través del software, el diseño, el marketing y la fotografía.
      </p>
    </div>
  </section>
</Base>