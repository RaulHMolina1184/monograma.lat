
---
import Base from '../../layouts/Base.astro';

const servicios = {
  marketing: {
    numero: '01',
    titulo: 'Marketing',
    subtitulo: 'Construimos marcas. Desarrollamos comunicación.',
    descripcion:
      'Desarrollamos la identidad y comunicación de marcas mediante diseño, marketing y contenido visual. Ayudamos a empresas y emprendedores a definir cómo se presentan, promocionan sus productos y servicios y se relacionan con sus clientes.',

    servicios: [
      {
        titulo: 'Diseño de marca',
        descripcion:
          'Creamos identidades visuales, logotipos y sistemas gráficos que representan la personalidad y los valores de cada negocio.'
      },
      {
        titulo: 'Diseño gráfico',
        descripcion:
          'Diseñamos material publicitario, piezas digitales y recursos gráficos para comunicar productos, servicios y promociones.'
      },
      {
        titulo: 'Marketing',
        descripcion:
          'Desarrollamos estrategias, campañas y acciones de marketing orientadas a mejorar la comunicación y promoción de tu negocio.'
      },
      {
        titulo: 'Gestión de redes sociales',
        descripcion:
          'Planificamos y producimos contenido, administramos perfiles y gestionamos la comunicación de tu marca en medios digitales.'
      },
      {
        titulo: 'Fotografía',
        descripcion:
          'Producimos fotografías comerciales, de productos y corporativas para fortalecer la presentación visual de tu negocio.'
      }
    ],

    necesidades: [
      'Crear una marca desde cero o renovar su identidad.',
      'Mejorar la imagen y presentación de un negocio.',
      'Promocionar productos y servicios.',
      'Mantener una comunicación constante en redes sociales.',
      'Generar contenido visual para campañas y publicidad.'
    ],

    proceso: [
      'Conocemos tu negocio y sus objetivos.',
      'Definimos las necesidades y la estrategia.',
      'Desarrollamos las propuestas creativas.',
      'Implementamos y entregamos las soluciones.'
    ],

    beneficio:
      'Una marca bien construida necesita una comunicación coherente. Integramos diseño, contenido y marketing para que cada elemento trabaje en favor de tu negocio.'
  },

  'soluciones-tecnologicas': {
    numero: '02',
    titulo: 'Soluciones Tecnológicas',
    subtitulo: 'Desarrollamos tecnología. Resolvemos problemas.',
    descripcion:
      'Desarrollamos e implementamos soluciones tecnológicas para empresas y emprendedores. Trabajamos con software, equipos informáticos y soporte técnico para resolver problemas, optimizar recursos y mantener la tecnología de cada negocio en funcionamiento.',

    servicios: [
      {
        titulo: 'Desarrollo de software',
        descripcion:
          'Diseñamos y desarrollamos sistemas, aplicaciones e integraciones adaptadas a las necesidades y procesos de cada negocio.'
      },
      {
        titulo: 'Desarrollo web',
        descripcion:
          'Creamos páginas web y soluciones digitales para presentar negocios, ofrecer servicios y fortalecer su presencia en internet.'
      },
      {
        titulo: 'Hardware',
        descripcion:
          'Realizamos diagnóstico, configuración, instalación, actualización y mantenimiento de equipos informáticos.'
      },
      {
        titulo: 'Soporte técnico',
        descripcion:
          'Brindamos asistencia técnica, identificamos problemas y ejecutamos mantenimiento preventivo y correctivo de equipos y sistemas.'
      }
    ],

    necesidades: [
      'Desarrollar una página web o sistema informático.',
      'Automatizar tareas y mejorar procesos de trabajo.',
      'Resolver problemas con equipos informáticos.',
      'Instalar, configurar o actualizar hardware.',
      'Contar con asistencia y mantenimiento tecnológico.'
    ],

    proceso: [
      'Identificamos el problema o necesidad tecnológica.',
      'Evaluamos las alternativas y definimos una solución.',
      'Implementamos, configuramos o desarrollamos.',
      'Verificamos el funcionamiento y entregamos la solución.'
    ],

    beneficio:
      'La tecnología debe facilitar el trabajo, no complicarlo. Buscamos soluciones funcionales y adecuadas a las necesidades reales de cada negocio.'
  }
};

export function getStaticPaths() {
  return [
    { params: { slug: 'marketing' } },
    { params: { slug: 'soluciones-tecnologicas' } }
  ];
}

const { slug } = Astro.params;
const servicio = servicios[slug as keyof typeof servicios];

if (!servicio) {
  return Astro.redirect('/404');
}
---

<Base title={`${servicio.titulo} — Monograma`}>

  <section class="section service-page">
    <div class="container">

      <a href="/#features" class="back-link">
        ← Volver a servicios
      </a>

      <!-- ENCABEZADO -->
      <header class="service-header">
        <span class="service-number">{servicio.numero}</span>

        <h1>{servicio.titulo}</h1>

        <h2>{servicio.subtitulo}</h2>

        <p>{servicio.descripcion}</p>
      </header>

      <!-- SERVICIOS -->
      <section class="service-section">
        <span class="section-label">LO QUE HACEMOS</span>
        <h2>¿Qué podemos hacer por tu negocio?</h2>

        <div class="services-grid">
          {servicio.servicios.map((item, index) => (
            <article class="service-card">
              <span class="card-number">
                {String(index + 1).padStart(2, '0')}
              </span>

              <h3>{item.titulo}</h3>
              <p>{item.descripcion}</p>
            </article>
          ))}
        </div>
      </section>

      <!-- NECESIDADES -->
      <section class="service-section needs-section">
        <span class="section-label">SOLUCIONES</span>
        <h2>¿En qué podemos ayudarte?</h2>

        <p class="section-intro">
          Cada negocio tiene necesidades diferentes.
          Estos son algunos de los escenarios en los que
          podemos aportar soluciones.
        </p>

        <ul class="needs-list">
          {servicio.necesidades.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      </section>

      <!-- BENEFICIO -->
      <section class="highlight-box">
        <h2>Más que un servicio, una solución.</h2>
        <p>{servicio.beneficio}</p>
      </section>

      <!-- PROCESO -->
      <section class="service-section process-section">
        <span class="section-label">METODOLOGÍA</span>
        <h2>¿Cómo trabajamos?</h2>

        <div class="process-grid">
          {servicio.proceso.map((item, index) => (
            <article class="process-card">
              <span>{String(index + 1).padStart(2, '0')}</span>
              <p>{item}</p>
            </article>
          ))}
        </div>
      </section>

      <!-- CONTACTO -->
      <section class="service-cta">
        <h2>¿Tenés un proyecto en mente?</h2>
        <p>
          Contanos qué necesitás. Analizamos tu proyecto
          y buscamos una solución adecuada para tu negocio.
        </p>

        <a href="/contact" class="btn btn-primary">
          Hablemos de tu proyecto →
        </a>
      </section>

    </div>
  </section>

  <style>
    .service-page {
      padding: 8rem 0 5rem;
    }

    .service-page .container {
      max-width: 1000px;
    }

    .back-link {
      display: inline-block;
      color: var(--ink-soft);
      text-decoration: none;
      margin-bottom: 3rem;
      transition: color 0.2s ease;
    }

    .back-link:hover {
      color: var(--nintendo-red);
    }

    .service-header {
      max-width: 800px;
      margin-bottom: 6rem;
    }

    .service-number,
    .section-label {
      color: var(--nintendo-red);
      font-weight: 700;
      letter-spacing: 0.12em;
      text-transform: uppercase;
    }

    .service-number {
      font-size: 1.4rem;
    }

    .service-header h1 {
      font-family: var(--font-display);
      font-size: clamp(2.8rem, 7vw, 5rem);
      line-height: 1.05;
      margin: 1rem 0;
      color: var(--ink);
    }

    .service-header h2 {
      font-size: clamp(1.2rem, 3vw, 1.7rem);
      margin-bottom: 1.5rem;
    }

    .service-header p,
    .section-intro {
      color: var(--ink-soft);
      font-size: 1.15rem;
      line-height: 1.8;
    }

    .service-section {
      margin: 5rem 0;
    }

    .service-section > h2 {
      font-family: var(--font-display);
      font-size: clamp(2rem, 4vw, 3rem);
      margin: 0.8rem 0 2rem;
    }

    .services-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 1.25rem;
    }

    .service-card,
    .process-card {
      padding: 2rem;
      border: 1px solid color-mix(
        in srgb, var(--ink) 15%, transparent
      );
      border-radius: 12px;
    }

    .card-number,
    .process-card span {
      color: var(--nintendo-red);
      font-weight: 700;
      font-size: 0.9rem;
    }

    .service-card h3 {
      font-family: var(--font-display);
      font-size: 1.5rem;
      margin: 1rem 0 0.75rem;
    }

    .service-card p,
    .process-card p {
      color: var(--ink-soft);
      line-height: 1.7;
      margin: 0;
    }

    .needs-section {
      padding: 3rem 0;
    }

    .needs-list {
      list-style: none;
      padding: 0;
      margin-top: 2rem;
    }

    .needs-list li {
      padding: 1rem 0 1rem 2rem;
      border-bottom: 1px solid color-mix(
        in srgb, var(--ink) 12%, transparent
      );
      position: relative;
      line-height: 1.6;
    }

    .needs-list li::before {
      content: '→';
      position: absolute;
      left: 0;
      color: var(--nintendo-red);
      font-weight: 700;
    }

    .highlight-box {
      background: var(--pixel-black);
      color: var(--paper-white);
      padding: clamp(2rem, 5vw, 3.5rem);
      border-radius: 12px;
      margin: 5rem 0;
    }

    .highlight-box h2 {
      font-family: var(--font-display);
      color: var(--nintendo-red);
      font-size: 1.8rem;
      margin-top: 0;
    }

    .highlight-box p {
      color: rgba(250, 248, 243, 0.85);
      font-size: 1.1rem;
      line-height: 1.8;
      margin-bottom: 0;
    }

    .process-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 1rem;
    }

    .process-card {
      padding: 1.5rem;
    }

    .process-card p {
      margin-top: 1rem;
    }

    .service-cta {
      text-align: center;
      padding: 4rem 1rem;
      margin-top: 5rem;
      border-top: 1px solid color-mix(
        in srgb, var(--ink) 15%, transparent
      );
    }

    .service-cta h2 {
      font-family: var(--font-display);
      font-size: clamp(2rem, 5vw, 3rem);
    }

    .service-cta p {
      max-width: 600px;
      margin: 1rem auto 2rem;
      color: var(--ink-soft);
      line-height: 1.7;
    }

    .service-cta .btn {
      display: inline-block;
      background: var(--nintendo-red);
      color: var(--paper-white);
      padding: 1rem 2rem;
      border-radius: 8px;
      font-weight: 700;
      text-decoration: none;
    }

    @media (max-width: 700px) {
      .services-grid {
        grid-template-columns: 1fr;
      }

      .process-grid {
        grid-template-columns: repeat(2, 1fr);
      }

      .service-page {
        padding-top: 6rem;
      }
    }

    @media (max-width: 420px) {
      .process-grid {
        grid-template-columns: 1fr;
      }
    }
  </style>

</Base>
